# Tüm alanlar boşken ücretsiz, yerel üretim kullanılabilir.
# Gizli anahtarları yalnızca kendi .env dosyanızda saklayın; değişiklikten sonra uygulamayı yeniden başlatın.
HYPE_PORT=8787
# HYPE_DATA_DIR=/absolute/path/to/data
# LOCAL_TTS_VOICE=Yelda
# LOCAL_TTS_ROOT=/workspace/.tools/espeak

# İsteğe bağlı: Ollama ile ücretsiz, cihazda çalışan dil modeli.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# İsteğe bağlı ve ücretli olabilir: web aboneliklerinden ayrı API ürünleri.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# İsteğe bağlı: kişisel YouTube hesabına OAuth ile yükleme.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8787/oauth/youtube/callback
